# Linker script that exports only symbols required for JNI to work.
# (From Chromium's build/android/android_only_jni_exports.lst, without its
# Chromium-only CrashpadHandlerMain and NativeChildProcessService_onCreate.)

{
  global:
    JNI_OnLoad;
    Java_*;
  local:
    *;
};
